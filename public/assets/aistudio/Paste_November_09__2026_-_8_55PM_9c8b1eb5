<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Permit Payment Registry</title>
<style>
:root{--ink:#17232b;--paper:#f2f8fb;--card:#fff;--line:#cfe0ea;--brand:#1d6fa8;--brand-d:#14527f;--on-brand:#fff;--stamp:#b3302a;--muted:#4f6572;--ok:#3f6b2a;--leaf:#3f6b2a;--sun:#fcee21;--sun-d:#c9a800;--soon:#8a6a00;--hdr-btn:#0f4a73;--g1:#d9eefa;--g2:#eaf5fb;--g3:#fbecef}
@media (prefers-color-scheme:dark){:root{--ink:#e8f1f5;--paper:#0f1b22;--card:#162832;--line:#2b4350;--brand:#6cb8ea;--brand-d:#92cdf2;--on-brand:#0b2230;--stamp:#ef7d75;--muted:#9db3bf;--ok:#8fcf6b;--leaf:#8fcf6b;--sun-d:#e5c800;--soon:#e5c800;--g1:#0f2a38;--g2:#0f1b22;--g3:#241d22}}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 "Segoe UI",system-ui,-apple-system,Roboto,sans-serif}
header{padding:14px max(20px,calc((100% - 1060px)/2));background:var(--sun);color:#17232b;border-bottom:5px solid var(--brand);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
h1{margin:0;font:700 26px/1.2 Georgia,"Times New Roman",serif;letter-spacing:.2px}
header p{margin:2px 0 0;color:#3d3a00}
header .sub{color:#3d3a00}
header button.ghost{color:var(--hdr-btn);border-color:var(--hdr-btn)}
header button.ghost:hover{background:rgba(255,255,255,.5)}
main{max-width:1100px;margin:auto;padding:0 20px 40px;display:grid;gap:18px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
.stat{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--brand);padding:12px 14px;border-radius:6px}
.stat b{display:block;font:700 22px Georgia,serif}
.stat span{color:var(--muted);font-size:13px}
.stat:nth-child(3){border-left-color:var(--leaf)}
.stat:nth-child(4){border-left-color:var(--sun-d)}
tbody tr:hover{background:rgba(70,159,225,.08)}
section.panel{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:18px}
h2{margin:0 0 12px;font:700 18px Georgia,serif}
form{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}
label{display:grid;gap:4px;font-size:13px;color:var(--muted);font-weight:600}
input,select,textarea{font:inherit;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:5px;padding:8px 10px;width:100%}
input:focus,select:focus,button:focus-visible{outline:2px solid var(--brand);outline-offset:1px}
.full{grid-column:1/-1}
.actions{display:flex;gap:8px;flex-wrap:wrap;grid-column:1/-1}
button{font:inherit;font-weight:600;border:1px solid var(--brand);background:var(--brand);color:var(--on-brand);border-radius:5px;padding:8px 16px;cursor:pointer}
button:hover{background:var(--brand-d)}
button.ghost{background:transparent;color:var(--brand)}
button.ghost:hover{background:var(--paper)}
button.danger{border-color:var(--stamp);color:var(--stamp);background:transparent}
button.sm{padding:3px 9px;font-size:13px}
.tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.tools input{flex:1 1 220px}.tools select{width:auto}
.wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:820px}
th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:13px;color:var(--muted);cursor:pointer;white-space:nowrap}
td.amt,th.amt{text-align:right;font-variant-numeric:tabular-nums}
.tag{display:inline-block;padding:1px 8px;border-radius:99px;font-size:12px;font-weight:600;border:1px solid}
.tag.Business{color:var(--brand);border-color:var(--brand)}
.tag.Building{color:var(--leaf);border-color:var(--leaf)}
.sub{color:var(--muted);font-size:13px}
.empty{padding:26px;text-align:center;color:var(--muted)}
#toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:var(--ink);color:var(--paper);padding:8px 16px;border-radius:5px;opacity:0;transition:opacity .2s;pointer-events:none}
#toast.on{opacity:1}
#auth{min-height:100vh;display:grid;place-items:center;padding:20px;background:linear-gradient(180deg,var(--g1),var(--g2) 55%,var(--g3))}
.authcard,dialog{background:var(--card);color:var(--ink);border:1px solid var(--line);border-top:6px solid var(--sun);border-radius:6px;padding:24px;width:min(380px,100%)}
dialog::backdrop{background:rgba(0,0,0,.45)}
.authcard h1{font-size:22px;margin-bottom:4px}
.authcard form,dialog form{grid-template-columns:1fr}
.brand{display:flex;gap:14px;align-items:center}
.logo{width:72px;height:72px;flex:0 0 auto;border:2px dashed var(--line);border-radius:8px;display:grid;place-items:center;color:var(--muted);font:600 12px/1 inherit;background:var(--paper);overflow:hidden}
.logo img{width:100%;height:100%;object-fit:contain;display:block}
.logo.has{border:3px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.3);background:#fff}
.logo.round,.logo.round img{border-radius:50%}
.logo.edit{cursor:pointer}
.authcard .logo{width:112px;height:112px;margin:0 auto 12px}
.authcard{text-align:center}.authcard label{text-align:left}
.confirm{display:grid;grid-template-rows:0fr;opacity:0;margin-top:-12px;visibility:hidden;
  transition:grid-template-rows .32s ease,opacity .25s ease,margin-top .32s ease,visibility 0s linear .32s}
.confirm.show{grid-template-rows:1fr;opacity:1;margin-top:0;visibility:visible;
  transition:grid-template-rows .32s ease,opacity .3s ease .08s,margin-top .32s ease,visibility 0s}
.confirm>div{overflow:hidden;min-height:0;padding:2px}
.swap{animation:swapIn .28s ease}
@keyframes swapIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
#authBtn{transition:background .2s}
.chk{display:flex!important;gap:8px;align-items:center;font-weight:400;font-size:13px;cursor:pointer}
.chk input{width:auto}
.acct{margin:12px 0 0;font-size:12px}
.warn{background:var(--stamp);color:#fff;padding:8px 16px;text-align:center;font-size:14px;font-weight:600}
.tag.Active{color:var(--ok);border-color:var(--ok)}
.tag.Soon{color:var(--soon);border-color:var(--soon)}
.tag.Expired{color:var(--stamp);border-color:var(--stamp)}
.hint{font-size:12px;font-weight:600;color:var(--muted)}
.hint:empty{display:none}
.hint.bad{color:var(--stamp)}.hint.good{color:var(--ok)}
input.bad{border-color:var(--stamp)}
.meter{height:6px;border-radius:99px;background:var(--line);overflow:hidden;margin:2px 0 4px}
.meter span{display:block;height:100%;width:0;border-radius:99px;background:var(--stamp);transition:width .3s ease,background .3s ease}
.meter span.s2{background:#c98a1b}.meter span.s3{background:var(--brand)}.meter span.s4{background:var(--ok)}
#meterText{margin:0;font-size:12px;text-align:left}
.ok{color:var(--ok)!important}
.err{color:var(--stamp);font-size:13px;min-height:18px;margin:0}
.dates{align-items:flex-end}
.dates label{flex:0 0 auto}
@media print{form,.tools,header button,.noprint,#toast{display:none!important}body{background:#fff;color:#000}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);display:grid;place-items:center;padding:16px;z-index:50}
.mcard{background:var(--card);color:var(--ink);border:1px solid var(--line);border-top:5px solid var(--brand);border-radius:6px;padding:20px;width:min(560px,100%);display:grid;gap:10px}
.mcard h2{margin:0}.mcard p{margin:0}
.mcard textarea{font:12px/1.4 ui-monospace,Consolas,monospace;min-height:180px;white-space:pre;resize:vertical}
.mcard .actions{display:flex;gap:8px;flex-wrap:wrap}
</style>
</head>
<body>
<div class="warn" id="jsWarn" role="alert">This app needs JavaScript. If you can read this and Sign in does nothing, open the file in Chrome, Edge or Firefox from your computer or phone browser (not a file preview).</div>
<div class="warn" id="storeWarn" role="alert" hidden>Your browser is blocking saved data, so accounts and records will be lost when you close this page. Open this file directly from your computer in Chrome, Edge or Firefox.</div>
<div id="auth">
  <div class="authcard">
    <div class="logo" id="authLogo" aria-label="Logo"></div>
    <h1>Permit Payment Registry</h1>
    <p class="sub" id="authSub"></p>
    <form id="authForm" autocomplete="on" novalidate>
      <label>Username<input name="user" required minlength="3" maxlength="40" autocomplete="username"><span class="hint" id="userHint"></span></label>
      <label>Password<input name="pass" type="password" required minlength="6" autocomplete="current-password"><span class="hint" id="passHint"></span></label>
      <div id="strengthWrap" class="confirm" aria-hidden="true"><div>
        <div class="meter" aria-hidden="true"><span id="meterBar"></span></div>
        <p class="sub" id="meterText" aria-live="polite"></p>
      </div></div>
      <div id="confirmWrap" class="confirm" aria-hidden="true"><div><label>Confirm password<input name="pass2" type="password" autocomplete="new-password" disabled><span class="hint" id="confirmHint"></span></label></div></div>
      <label class="chk"><input type="checkbox" id="showPw"> Show password</label>
      <p class="err" id="authErr" role="alert"></p>
      <button type="button" id="authBtn">Sign in</button>
    </form>
    <p class="sub" style="margin:14px 0 0"><span id="toggleText"></span> <button type="button" class="ghost sm" id="toggleMode"></button></p>
    <p class="sub acct"><span id="acctInfo"></span> <button type="button" class="ghost sm" id="resetAcct">Can't sign in? Reset accounts</button></p>
  </div>
</div>
<div id="app" hidden>
<header>
  <div class="brand">
    <div class="logo edit" id="appLogo" role="button" tabindex="0" title="Select to change the logo"></div>
    <div>
      <h1>Permit Payment Registry</h1>
      <p>Record businesses that paid their business permit or building permit.</p>
    </div>
  </div>
  <div class="noprint" style="display:flex;gap:8px;flex-wrap:wrap">
    <span class="sub" id="who" style="align-self:center"></span>
    <button class="ghost" id="exportCsv">Export CSV</button>
    <button class="ghost" id="backup">Save backup</button>
    <button class="ghost" id="restoreBtn">Restore backup</button>
    <button class="ghost" onclick="window.print()">Print</button>
    <button id="signOut">Sign out</button>
    <button class="ghost" id="rmLogo" hidden>Use default logo</button>
    <input type="file" id="logoFile" accept="image/*" hidden>
  </div>
</header>

<main>
  <div class="stats">
    <div class="stat"><b id="sCount">0</b><span>Paid records</span></div>
    <div class="stat"><b id="sBiz">₱0.00</b><span>Business permit total</span></div>
    <div class="stat"><b id="sBld">₱0.00</b><span>Building permit total</span></div>
    <div class="stat"><b id="sAll">₱0.00</b><span>Total collected</span></div>
  </div>

  <section class="panel">
    <h2 id="formTitle">Add paid permit</h2>
    <form id="f">
      <label>Business name *<input name="business" required maxlength="120"></label>
      <label>Owner / Representative *<input name="owner" required maxlength="100"></label>
      <label>Business address / Barangay<input name="address" maxlength="160"></label>
      <label>Permit type *
        <select name="type" required>
          <option>Business</option>
          <option>Building</option>
        </select>
      </label>
      <label>Permit number<input name="permitNo" maxlength="40"></label>
      <label>Official receipt (OR) number<input name="orNo" maxlength="40"></label>
      <label>Amount paid (₱) *<input name="amount" type="number" min="0" step="0.01" required></label>
      <label>Date paid *<input name="date" type="date" required></label>
      <label>Valid until<input name="valid" type="date"></label>
      <label class="full">Remarks<textarea name="remarks" rows="2" maxlength="300"></textarea></label>
      <div class="actions">
        <button type="button" id="saveBtn">Save record</button>
        <button type="button" class="ghost" id="cancelEdit" hidden>Cancel edit</button>
        <button type="button" class="ghost" id="resetBtn">Clear form</button>
      </div>
    </form>
  </section>

  <section class="panel">
    <h2>Paid records</h2>
    <div class="tools noprint">
      <input id="q" type="search" placeholder="Search business, owner, permit no., OR no.">
      <select id="ft"><option value="">All permit types</option><option value="Business">Business permit</option><option value="Building">Building permit</option></select>
      <select id="fy"><option value="">All years</option></select>
      <select id="fs"><option value="">All validity</option><option value="Active">Active</option><option value="Expiring soon">Expiring soon (30 days)</option><option value="Expired">Expired</option></select>
    </div>
    <div class="tools dates noprint">
      <label>Date paid from<input type="date" id="df"></label>
      <label>to<input type="date" id="dt"></label>
      <button class="ghost" type="button" data-range="today">Today</button>
      <button class="ghost" type="button" data-range="month">This month</button>
      <button class="ghost" type="button" data-range="year">This year</button>
      <button class="ghost" type="button" data-range="clear">Clear dates</button>
    </div>
    <div class="wrap">
      <table>
        <thead><tr>
          <th data-k="business">Business</th>
          <th data-k="type">Permit</th>
          <th data-k="orNo">OR no.</th>
          <th data-k="date">Date paid</th>
          <th data-k="valid">Valid until</th>
          <th data-k="amount" class="amt">Amount</th>
          <th class="noprint"></th>
        </tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
    <div class="empty" id="empty" hidden>No records yet. Fill in the form above and select Save record.</div>
  </section>
</main>
</div>
<div class="modal" id="modal" hidden><div class="mcard" role="dialog" aria-modal="true" aria-labelledby="mTitle">
  <h2 id="mTitle"></h2>
  <p class="sub" id="mMsg"></p>
  <textarea id="mText" rows="9" hidden></textarea>
  <input type="file" id="mFile" accept=".json,application/json" hidden>
  <div class="actions" id="mBtns"></div>
</div></div>
<div id="toast" role="status"></div>

<script>
function boot(){
  var KEY="permitRegistry.v1", data=[], editId=null, sortK="date", sortDir=-1;
  var $=function(s){return document.querySelector(s)};
  $("#jsWarn").hidden=true;
  var f=$("#f"), mem={};
  var store={
    get:function(k){try{return localStorage.getItem(k)}catch(e){return mem[k]===undefined?null:mem[k]}},
    set:function(k,v){try{localStorage.setItem(k,v);return true}catch(e){mem[k]=v;$("#storeWarn").hidden=false;return false}},
    del:function(k){try{localStorage.removeItem(k)}catch(e){}delete mem[k]}
  };
  (function(){try{localStorage.setItem("permitRegistry.test","1");localStorage.removeItem("permitRegistry.test")}catch(e){$("#storeWarn").hidden=false}})();

  function load(){try{data=JSON.parse(store.get(KEY)||"[]")}catch(e){data=[]}}
  function save(){store.set(KEY,JSON.stringify(data))}
  function peso(n){return "₱"+Number(n||0).toLocaleString("en-PH",{minimumFractionDigits:2,maximumFractionDigits:2})}
  function esc(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
  function toast(m){var t=$("#toast");t.textContent=m;t.classList.add("on");clearTimeout(toast.t);toast.t=setTimeout(function(){t.classList.remove("on")},2200)}
  function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,6)}
  function today(){var d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")}

  function status(r){
    if(!r.valid)return "";
    var t=today();if(r.valid<t)return "Expired";
    return (new Date(r.valid)-new Date(t))/864e5<=30?"Expiring soon":"Active";
  }
  function stTag(r){var st=status(r);return st?'<div><span class="tag '+(st==="Expiring soon"?"Soon":st)+'">'+st+'</span></div>':""}
  function years(){
    var ys={};data.forEach(function(r){if(r.date)ys[r.date.slice(0,4)]=1});
    var sel=$("#fy"),cur=sel.value;
    sel.innerHTML='<option value="">All years</option>'+Object.keys(ys).sort().reverse().map(function(y){return '<option>'+y+'</option>'}).join("");
    sel.value=cur;
  }

  function render(){
    var q=$("#q").value.trim().toLowerCase(), t=$("#ft").value, y=$("#fy").value, fs=$("#fs").value;
    var list=data.filter(function(r){
      if(t&&r.type!==t)return false;
      if(fs&&status(r)!==fs)return false;
      if(y&&(r.date||"").slice(0,4)!==y)return false;
      if($("#df").value&&(r.date||"")<$("#df").value)return false;
      if($("#dt").value&&(r.date||"")>$("#dt").value)return false;
      if(!q)return true;
      return [r.business,r.owner,r.permitNo,r.orNo,r.address].join(" ").toLowerCase().indexOf(q)>-1;
    }).sort(function(a,b){
      var x=a[sortK],z=b[sortK];
      if(sortK==="amount"){x=+x;z=+z}else{x=String(x||"").toLowerCase();z=String(z||"").toLowerCase()}
      return x<z?-sortDir:x>z?sortDir:0;
    });
    var b=0,g=0;
    list.forEach(function(r){if(r.type==="Business")b+=+r.amount;else g+=+r.amount});
    $("#sCount").textContent=list.length;$("#sBiz").textContent=peso(b);$("#sBld").textContent=peso(g);$("#sAll").textContent=peso(b+g);
    $("#empty").hidden=list.length>0;
    $("#empty").textContent=data.length?"No records match your search or filters.":"No records yet. Fill in the form above and select Save record.";
    $("#rows").innerHTML=list.map(function(r){
      return '<tr><td><strong>'+esc(r.business)+'</strong><div class="sub">'+esc(r.owner)+(r.address?' · '+esc(r.address):'')+(r.remarks?'<br>'+esc(r.remarks):'')+'</div></td>'+
        '<td><span class="tag '+esc(r.type)+'">'+esc(r.type)+' permit</span><div class="sub">'+esc(r.permitNo)+'</div></td>'+
        '<td>'+esc(r.orNo)+'</td><td>'+esc(r.date)+'</td><td>'+esc(r.valid)+stTag(r)+'</td>'+
        '<td class="amt">'+peso(r.amount)+'</td>'+
        '<td class="noprint" style="white-space:nowrap"><button class="sm ghost" data-edit="'+r.id+'">Edit</button> <button class="sm danger" data-del="'+r.id+'">Delete</button></td></tr>';
    }).join("");
    years();
  }

  function setForm(r){
    ["business","owner","address","type","permitNo","orNo","amount","date","valid","remarks"].forEach(function(k){f.elements[k].value=r?r[k]||"":(k==="type"?"Business":k==="date"?today():"")});
  }
  function stopEdit(){editId=null;$("#formTitle").textContent="Add paid permit";$("#saveBtn").textContent="Save record";$("#cancelEdit").hidden=true;setForm(null)}

  function saveRecord(){
    if(!f.reportValidity())return;
    var r={};["business","owner","address","type","permitNo","orNo","amount","date","valid","remarks"].forEach(function(k){r[k]=f.elements[k].value.trim()});
    r.amount=parseFloat(r.amount)||0;
    if(editId){var i=data.findIndex(function(x){return x.id===editId});if(i>-1){r.id=editId;data[i]=r}toast("Record updated")}
    else{r.id=uid();data.push(r);toast("Record saved")}
    save();stopEdit();render();
  }
  $("#saveBtn").onclick=saveRecord;
  f.addEventListener("keydown",function(e){if(e.key==="Enter"&&e.target.tagName==="INPUT"){e.preventDefault();saveRecord()}});
  $("#resetBtn").onclick=stopEdit;
  $("#cancelEdit").onclick=stopEdit;

  $("#rows").addEventListener("click",function(e){
    var ed=e.target.getAttribute("data-edit"),dl=e.target.getAttribute("data-del");
    if(ed){var r=data.find(function(x){return x.id===ed});if(!r)return;editId=ed;setForm(r);
      $("#formTitle").textContent="Edit record";$("#saveBtn").textContent="Update record";$("#cancelEdit").hidden=false;f.scrollIntoView({behavior:"smooth"})}
    if(dl){var r2=data.find(function(x){return x.id===dl});
      if(r2)ask("Delete record","Delete the record for "+r2.business+"? This cannot be undone.","Delete").then(function(ok){if(ok){data=data.filter(function(x){return x.id!==dl});save();render();toast("Record deleted")}})}
  });

  document.querySelectorAll("th[data-k]").forEach(function(th){th.addEventListener("click",function(){
    var k=th.getAttribute("data-k");if(sortK===k)sortDir*=-1;else{sortK=k;sortDir=1}render()})});
  ["#q","#ft","#fy","#fs","#df","#dt"].forEach(function(s){$(s).addEventListener("input",render)});

  function download(name,text,type){
    var a=document.createElement("a");a.href=URL.createObjectURL(new Blob([text],{type:type}));a.download=name;
    document.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(a.href)},500);
  }
  $("#exportCsv").onclick=function(){
    var h=["Business","Owner","Address","Permit Type","Permit No","OR No","Amount","Date Paid","Valid Until","Status","Remarks"];
    var rows=data.map(function(r){return [r.business,r.owner,r.address,r.type,r.permitNo,r.orNo,r.amount,r.date,r.valid,status(r),r.remarks]});
    var csv="\ufeff"+[h].concat(rows).map(function(row){return row.map(function(c){return '"'+String(c==null?"":c).replace(/"/g,'""')+'"'}).join(",")}).join("\r\n");
    openText("Export CSV",csv,"permit-payments-"+today()+".csv","text/csv");
  };
  $("#backup").onclick=function(){openText("Save backup",JSON.stringify(data,null,2),"permit-backup-"+today()+".json","application/json")};
  /* ---------- Pop-up box (works where alert/confirm are blocked) ---------- */
  var mRes=null;
  function closeModal(v){$("#modal").hidden=true;var r=mRes;mRes=null;if(r)r(v)}
  function openModal(o){
    $("#mTitle").textContent=o.title;$("#mMsg").textContent=o.msg||"";
    var ta=$("#mText");ta.hidden=o.text===undefined;ta.value=o.text||"";ta.readOnly=!!o.readonly;
    var box=$("#mBtns");box.innerHTML="";
    o.buttons.forEach(function(b){
      var el=document.createElement("button");el.type="button";el.textContent=b.label;if(b.cls)el.className=b.cls;
      el.onclick=function(){b.run(ta.value,el)};box.appendChild(el);
    });
    $("#modal").hidden=false;
    if(!ta.hidden&&!o.readonly)ta.focus();else box.firstChild.focus();
  }
  function ask(title,msg,okLabel){
    return new Promise(function(res){
      mRes=res;
      openModal({title:title,msg:msg,buttons:[
        {label:"Cancel",cls:"ghost",run:function(){closeModal(false)}},
        {label:okLabel||"OK",cls:"danger",run:function(){closeModal(true)}}]});
    });
  }
  function copyText(t,btn){
    var ta=$("#mText");
    var done=function(){btn.textContent="Copied";setTimeout(function(){btn.textContent="Copy"},1500)};
    var old=function(){ta.focus();ta.select();var ok=false;try{ok=document.execCommand("copy")}catch(e){}ok?done():toast("Press Ctrl+C to copy the selected text")};
    try{if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(done,old);return}}catch(e){}
    old();
  }
  function openText(title,text,name,mime){
    openModal({title:title,msg:"Copy this text, or download it as "+name+".",text:text,readonly:true,buttons:[
      {label:"Copy",run:function(t,b){copyText(t,b)}},
      {label:"Download file",run:function(){download(name,text,mime)}},
      {label:"Close",cls:"ghost",run:function(){closeModal()}}]});
  }
  $("#modal").addEventListener("keydown",function(e){if(e.key==="Escape")closeModal(false)});
  $("#modal").addEventListener("click",function(e){if(e.target===this)closeModal(false)});
  $("#restoreBtn").onclick=function(){
    openModal({title:"Restore backup",msg:"Paste the backup text below, or choose a backup file. This replaces all current records.",text:"",buttons:[
      {label:"Choose file",cls:"ghost",run:function(){$("#mFile").click()}},
      {label:"Restore",run:function(t){
        try{var d=JSON.parse(t);if(!Array.isArray(d))throw 0;
          data=d.map(function(r){r.id=r.id||uid();return r});save();render();closeModal();toast("Backup restored: "+d.length+" records")}
        catch(err){$("#mMsg").textContent="That is not a valid backup. Paste the full text of a backup file."}}},
      {label:"Cancel",cls:"ghost",run:function(){closeModal()}}]});
  };
  $("#mFile").addEventListener("change",function(e){
    var file=e.target.files[0];e.target.value="";if(!file)return;
    var rd=new FileReader();rd.onload=function(){$("#mText").value=rd.result};rd.readAsText(file);
  });

  document.querySelectorAll("[data-range]").forEach(function(b){b.addEventListener("click",function(){
    var d=new Date(),t=today(),k=b.getAttribute("data-range"),from="",to="";
    if(k==="today"){from=to=t}
    else if(k==="month"){from=t.slice(0,8)+"01";to=t}
    else if(k==="year"){from=t.slice(0,4)+"-01-01";to=t}
    $("#df").value=from;$("#dt").value=to;render();
  })});

  /* ---------- Admin accounts (stored in this browser) ---------- */
  var UKEY="permitRegistry.users.v1",SKEY="permitRegistry.session",users=[];
  function loadUsers(){try{users=JSON.parse(store.get(UKEY)||"[]")}catch(e){users=[]}}
  function saveUsers(){store.set(UKEY,JSON.stringify(users))}
  function hex(buf){return Array.prototype.map.call(new Uint8Array(buf),function(b){return b.toString(16).padStart(2,"0")}).join("")}
  async function hashPw(pw,salt,weak){
    try{
      if(!weak&&window.crypto&&crypto.subtle){
        var enc=new TextEncoder(),km=await crypto.subtle.importKey("raw",enc.encode(pw),"PBKDF2",false,["deriveBits"]);
        var bits=await crypto.subtle.deriveBits({name:"PBKDF2",salt:enc.encode(salt),iterations:100000,hash:"SHA-256"},km,256);
        return "p:"+hex(bits);
      }
    }catch(e){}
    var h=5381,x=salt+pw;for(var i=0;i<x.length;i++)h=((h<<5)+h+x.charCodeAt(i))|0;
    return "s:"+(h>>>0).toString(16);
  }
  function newSalt(){var a=new Uint8Array(16);(window.crypto||{getRandomValues:function(v){for(var i=0;i<v.length;i++)v[i]=Math.random()*256}}).getRandomValues(a);return hex(a)}
  function strength(pw){
    var c={len:pw.length>=8,low:/[a-z]/.test(pw),up:/[A-Z]/.test(pw),num:/\d/.test(pw),sym:/[^A-Za-z0-9]/.test(pw)};
    var score=Object.keys(c).filter(function(k){return c[k]}).length;
    var level=!pw?0:(!c.len||score<=2)?1:score===3?2:score===4?3:4;
    var miss=[];if(!c.len)miss.push("8+ characters");if(!c.up)miss.push("an uppercase letter");if(!c.low)miss.push("a lowercase letter");if(!c.num)miss.push("a number");if(!c.sym)miss.push("a symbol");
    return {level:level,ok:c.len&&score>=4,miss:miss};
  }
  var LABELS=["","Weak","Fair","Good","Strong"];
  function updateMeter(){
    var st=strength($("#authForm").elements.pass.value),bar=$("#meterBar");
    bar.style.width=(st.level*25)+"%";bar.className=st.level?"s"+st.level:"";
    $("#meterText").textContent=st.level?(LABELS[st.level]+(st.ok?"":" - add "+st.miss.join(", "))):"Use 8+ characters with upper and lowercase letters, a number or a symbol.";
  }
  function setHint(id,msg,kind,inputName){
    var h=$(id);h.textContent=msg||"";h.className="hint"+(kind?" "+kind:"");
    if(inputName){$("#authForm").elements[inputName].classList.toggle("bad",kind==="bad")}
  }
  function clearHints(){setHint("#userHint","","","user");setHint("#passHint","","","pass");setHint("#confirmHint","","","pass2")}
  function nameTaken(n){loadUsers();return users.some(function(u){return u.name.toLowerCase()===n.toLowerCase()})}
  async function createUser(name,pw,pw2){
    name=name.trim();
    if(!/^[A-Za-z0-9._-]{3,40}$/.test(name))return {f:"user",m:"Use 3-40 letters, numbers, dots, dashes or underscores."};
    if(nameTaken(name))return {f:"user",m:"That username is already taken. Choose another."};
    var st=strength(pw);
    if(!st.ok)return {f:"pass",m:"Password is too weak. Add "+st.miss.join(", ")+"."};
    if(pw!==pw2)return {f:"pass2",m:"Passwords do not match."};
    var salt=newSalt();
    users.push({name:name,salt:salt,hash:await hashPw(pw,salt)});saveUsers();return null;
  }
  var mode="in";
  function showApp(name){
    $("#auth").hidden=true;$("#app").hidden=false;$("#who").textContent="Signed in as "+name;
    try{sessionStorage.setItem(SKEY,name)}catch(e){}
  }
  function setMode(m,msg){
    mode=m;var up=m==="up",fm=$("#authForm");
    $("#authSub").textContent=up?"Create an account to use the registry.":"Sign in to continue.";
    $("#authBtn").textContent=up?"Create account":"Sign in";
    $("#confirmWrap").classList.toggle("show",up);
    $("#confirmWrap").setAttribute("aria-hidden",up?"false":"true");
    $("#strengthWrap").classList.toggle("show",up);
    $("#strengthWrap").setAttribute("aria-hidden",up?"false":"true");
    fm.elements.pass2.disabled=!up;
    fm.elements.pass2.required=up;
    ["#authSub","#authBtn","#toggleText","#toggleMode"].forEach(function(id){
      var el=$(id);el.classList.remove("swap");void el.offsetWidth;el.classList.add("swap");
    });
    fm.elements.pass.autocomplete=up?"new-password":"current-password";
    $("#toggleText").textContent=up?"Already have an account?":"No account yet?";
    $("#toggleMode").textContent=up?"Sign in":"Create account";
    var er=$("#authErr");er.textContent=msg||"";er.classList.toggle("ok",!!msg);
    if(!msg)fm.reset();
    clearHints();updateMeter();
    loadUsers();
    $("#acctInfo").textContent=users.length?users.length+(users.length===1?" account is":" accounts are")+" saved in this browser.":"No accounts are saved in this browser yet.";
    $("#resetAcct").hidden=up;
  }
  function showAuth(){loadUsers();$("#app").hidden=true;$("#auth").hidden=false;setMode("in")}
  $("#toggleMode").onclick=function(){setMode(mode==="in"?"up":"in")};
  var FIELD={user:["#userHint","user"],pass:["#passHint","pass"],pass2:["#confirmHint","pass2"]};
  function fail(f,m){var t=FIELD[f];setHint(t[0],m,"bad",t[1]);$("#authForm").elements[t[1]].focus()}
  async function doAuth(){
    var form=$("#authForm"),el=form.elements,name=el.user.value.trim(),pw=el.pass.value;
    clearHints();$("#authErr").textContent="";$("#authErr").classList.remove("ok");
    try{
      loadUsers();
      if(!name){fail("user","Enter your username.");return}
      if(!pw){fail("pass","Enter your password.");return}
      if(mode==="up"){
        var err=await createUser(name,pw,el.pass2.value);
        if(err){fail(err.f,err.m);return}
        setMode("in","Account created. Sign in with your new username and password.");
        return;
      }
      var u=users.find(function(x){return x.name.toLowerCase()===name.toLowerCase()});
      if(!u){fail("user",users.length?"Username not found. Check the spelling or create an account.":"No accounts yet. Select Create account to make one.");return}
      var weak=u.hash.indexOf("s:")===0,h=await hashPw(pw,u.salt,weak);
      if(h.slice(0,2)!==u.hash.slice(0,2)){$("#authErr").textContent="This browser cannot check that account's password. Use Reset accounts below, or open the file in the browser where you made the account.";return}
      if(h!==u.hash){fail("pass","Incorrect password. Try again.");return}
      showApp(u.name);form.reset();clearHints();
    }catch(ex){
      $("#authErr").textContent="Sign in failed: "+(ex&&ex.message?ex.message:ex)+". Try Reset accounts below.";
    }
  }
  $("#authBtn").onclick=doAuth;
  $("#authForm").addEventListener("keydown",function(e){if(e.key==="Enter"&&e.target.tagName==="INPUT"&&e.target.type!=="checkbox"){e.preventDefault();doAuth()}});
  $("#authForm").elements.user.addEventListener("input",function(){
    $("#authErr").textContent="";var n=this.value.trim();
    if(mode!=="up"){setHint("#userHint","","","user");return}
    if(!n){setHint("#userHint","","","user")}
    else if(!/^[A-Za-z0-9._-]{3,40}$/.test(n)){setHint("#userHint","Use 3-40 letters, numbers, dots, dashes or underscores.","bad","user")}
    else if(nameTaken(n)){setHint("#userHint","That username is already taken. Choose another.","bad","user")}
    else{setHint("#userHint","Username is available.","good","user")}
  });
  $("#authForm").elements.pass.addEventListener("input",function(){
    $("#authErr").textContent="";setHint("#passHint","","","pass");
    if(mode==="up"){updateMeter();checkMatch()}
  });
  function checkMatch(){
    var f=$("#authForm").elements;
    if(mode!=="up"||!f.pass2.value){setHint("#confirmHint","","","pass2");return}
    f.pass2.value===f.pass.value?setHint("#confirmHint","Passwords match.","good","pass2"):setHint("#confirmHint","Passwords do not match.","bad","pass2");
  }
  $("#authForm").elements.pass2.addEventListener("input",checkMatch);
  $("#showPw").addEventListener("change",function(){
    var t=this.checked?"text":"password",f2=$("#authForm").elements;f2.pass.type=t;f2.pass2.type=t;
  });
  $("#resetAcct").onclick=function(){
    ask("Reset accounts","Remove all saved accounts? Your permit records are kept. You can then create a new account.","Remove accounts").then(function(ok){
      if(!ok)return;
      store.del(UKEY);users=[];
      setMode("in","Accounts removed. Select Create account to make a new one.");
    });
  };
  $("#signOut").onclick=function(){try{sessionStorage.removeItem(SKEY)}catch(e){}showAuth()};

  /* ---------- Logo placeholder ---------- */
  var DEFAULT_LOGO="data:image/jpeg;base64,";
  var LKEY="permitRegistry.logo.v1";
  function getLogo(){return store.get(LKEY)||DEFAULT_LOGO}
  function applyLogo(){
    var custom=store.get(LKEY),src=custom||DEFAULT_LOGO;
    ["#appLogo","#authLogo"].forEach(function(id){
      var el=$(id);el.classList.add("has");el.classList.toggle("round",!custom);
      el.innerHTML='<img alt="'+(custom?"Logo":"Municipality of Talisayan seal")+'" src="'+src+'">';
    });
    $("#rmLogo").hidden=!custom;
  }
  $("#appLogo").onclick=function(){$("#logoFile").click()};
  $("#appLogo").addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();$("#logoFile").click()}});
  $("#logoFile").addEventListener("change",function(e){
    var file=e.target.files[0];e.target.value="";
    if(!file)return;
    if(!/^image\//.test(file.type)){toast("Choose an image file (PNG, JPG, SVG)");return}
    if(file.size>500*1024){toast("Logo is too large. Use an image under 500 KB");return}
    var rd=new FileReader();
    rd.onload=function(){store.set(LKEY,rd.result);applyLogo();toast("Logo updated")};
    rd.readAsDataURL(file);
  });
  $("#rmLogo").onclick=function(){store.del(LKEY);applyLogo();toast("Default logo restored")};
  applyLogo();

  load();setForm(null);render();loadUsers();
  var sess=null;try{sess=sessionStorage.getItem(SKEY)}catch(e){}
  if(sess&&users.some(function(u){return u.name===sess}))showApp(sess);else showAuth();
}
if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",boot);else boot();
</script>
